{
  "_about": "Events house look. Sampled from the Attendee App launch film + 9 final release shots (reference/), 22 Nov 2026. Every video scene, screenshot card and overlay reads these values; nothing hard-codes colours or fonts.",
  "color": {
    "paper": "#e6e2da",
    "paper_edge": "#ded9d0",
    "paper_light": "#e5e2d9",
    "ink": "#1b1a16",
    "ink_text": "#171512",
    "muted_text": "#6d665c",
    "white": "#ffffff",
    "subtitle_pill": "rgba(23,21,18,0.78)",
    "label_bar_green": "#37ca37",
    "kicker_dots": [
      "#1a89f1",
      "#f9b803",
      "#37ca37"
    ],
    "highlevel_mark": {
      "yellow": "#f9b803",
      "blue": "#1a89f1",
      "green": "#37ca37"
    },
    "northstar": {
      "navy": "#201c46",
      "navy_grid": "#282452",
      "coral": "#fa694c",
      "muted": "#c8c6e1"
    }
  },
  "font": {
    "serif": {
      "family": "Instrument Serif",
      "files": [
        "fonts/InstrumentSerif-Regular.ttf",
        "fonts/InstrumentSerif-Italic.ttf"
      ],
      "use": "headlines, title cards, interstitial words; one italic emphasis word per headline"
    },
    "sans": {
      "family": "Inter",
      "files": [
        "fonts/Inter-Variable.ttf",
        "fonts/Inter-Italic-Variable.ttf"
      ],
      "use": "subheads, subtitles, captions, Northstar brand art"
    },
    "label": {
      "family": "Geist",
      "files": [
        "fonts/Geist-Variable.ttf"
      ],
      "use": "kickers and chapter labels, letter-spaced caps"
    }
  },
  "card": {
    "_about": "Release screenshot card (house format of reference/shots).",
    "size": [
      3200,
      2000
    ],
    "background": "radial paper: paper at centre to paper_edge at corners",
    "kicker": {
      "font": "label",
      "weight": 500,
      "size": 31,
      "tracking": 0.125,
      "dot_diameter": 20,
      "color": "muted_text",
      "hero_text": "NEW IN HIGHLEVEL EVENTS",
      "section_pattern": "0N · TOPIC",
      "dot_cycle_sections": [
        "green",
        "amber",
        "blue"
      ],
      "hero_dot": "blue"
    },
    "headline": {
      "font": "serif",
      "size_hero": 177,
      "size_section": 136,
      "color": "ink_text",
      "italic_words": 1,
      "line_break": "\\n in spec; side cards max 2 lines"
    },
    "subhead": {
      "font": "sans",
      "weight": 400,
      "size": 42,
      "color": "muted_text",
      "max_lines": 3,
      "line_height": 61
    },
    "device_caption": {
      "font": "label",
      "size": 30,
      "tracking": 0.2,
      "color": "muted_text"
    },
    "browser_frame": {
      "radius": 30,
      "bar_height": 76,
      "traffic_lights": [
        "#d2ccc2",
        "#d2ccc2",
        "#d2ccc2"
      ],
      "url_example": "members.northstarcollective.com/events",
      "shadow": "0 40px 80px rgba(23,21,18,0.18)",
      "url_pill": "#e2ddd5",
      "bar": "#ece9e4"
    },
    "phone_frame": {
      "radius": 64,
      "bezel": "#11100f",
      "shadow": "0 40px 80px rgba(23,21,18,0.22)",
      "outer_ratio_h_over_w": 2.073,
      "bezel_of_width": 0.038,
      "radius_of_width": 0.163,
      "default_width": 578,
      "gap": 43
    },
    "layouts": [
      "hero: centred text, one browser frame (may bleed off the bottom)",
      "side + stage 'phones': text left, 1-3 phones with captions",
      "side + layers: text left, free browser/panel/phone layers (overlap, tilt) for creative compositions"
    ],
    "renderer": "cards/render_card.py + cards/card.html (headless Chrome, 1600x1000 CSS @2x). Geometry below is what the renderer uses, measured from reference/shots."
  },
  "video": {
    "render": {
      "width": 1920,
      "height": 1080,
      "fps": 60,
      "codec": "h264",
      "audio": "aac 48k stereo",
      "target_mb": 60,
      "hard_limit_mb": 100,
      "reference": "3840x2160 60fps 130s 86MB, Remotion 4.0.535"
    },
    "length_seconds": [
      30,
      120
    ],
    "cold_open": {
      "background": "ink",
      "text_font": "serif",
      "text_color": "white",
      "pattern": "old pain line → beat → 'Not anymore.'"
    },
    "title_card": {
      "background": "paper",
      "kicker": "HIGHLEVEL",
      "headline": "Introducing <italic feature>."
    },
    "chapter_label": {
      "style": "white pill, green left bar, letter-spaced caps (label font)",
      "position": "top-left",
      "examples": [
        "YOUR APP",
        "BEFORE THE EVENT",
        "STAY IN TOUCH",
        "AT THE EVENT",
        "SPONSORS",
        "ADS",
        "CUSTOMIZE",
        "ON THE WEB"
      ]
    },
    "devices": "laptop (builder/portal) + phone (app) on paper_light; depth-of-field blur on the inactive device",
    "pointer": "hand-tap illustration for taps; cursor for web clicks; slow zoom to the key control",
    "interstitial": "serif word between sections (e.g. 'Overview page', 'Agenda')",
    "subtitles": {
      "style": "subtitle_pill, bottom-centre, white sans",
      "every_vo_line": true
    },
    "end_card": {
      "background": "ink",
      "logo": "HighLevel mark",
      "tagline_font": "serif",
      "pattern": "benefit tagline with one italic word + small grey line + 'Live now'"
    }
  },
  "rules": [
    "No purple glows, gradient text or generic 'AI' look.",
    "Real product UI only; fictional Northstar data only.",
    "Product name on screen and in VO: \"Events'\" + feature name."
  ]
}